{
  "name": "rbc-pzn",
  "main": "src/index.js",
  "compatibility_date": "2025-08-23",

  // Conductrics wiring lives in scripts/pzn-config.js, shared with the client half so the two
  // cannot disagree. AGENT_SET names which of RBC's agent sets covers this deployment's URLs, and
  // CANONICAL_ORIGIN is the address those agents target, which is not the host the worker answers
  // on. Both come from .dev.vars locally and from Cloudflare vars once deployed.

  "vars": {
    "ORIGIN": "http://localhost:3000",
    "AGENT_SET": "dev"
  },
  "env": {
    // Conductrics has the EDS URLs enabled on .page, not .live, so the demo fronts preview.
    // RULES_KEY and CONDUCTRICS_URL carry keys and are set with `wrangler secret put`, never here.
    "preview": {
      "workers_dev": true,
      "vars": {
        "ORIGIN": "https://main--rbc--aemsites.aem.page",
        "AGENT_SET": "eds",
        "CANONICAL_ORIGIN": "https://main--rbc--aemsites.aem.page",
        "RULES_URL": "https://ssgtmactivation.rbc.com/rules-engine"
      }
    },
    "production": {
      "vars": {
        "ORIGIN": "https://main--rbc--aemsites.aem.live",
        "AGENT_SET": "eds",
        "CANONICAL_ORIGIN": "https://main--rbc--aemsites.aem.live"
      }
    }
  }
}
